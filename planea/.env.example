# ─────────────────────────────────────────────────────────────
# PLANEA — variables de entorno
# La app funciona SIN ninguna de estas variables (modo demo:
# datos de ejemplo + cuentas locales en el navegador).
# ─────────────────────────────────────────────────────────────

# URL pública de la app (SEO, sitemap, enlaces para compartir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (activa el modo producción) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Activa el botón "Continuar con Google" (configura el proveedor en Supabase → Auth → Providers)
NEXT_PUBLIC_AUTH_GOOGLE=0

# --- Mapas (opcional) ---
# Sin token se usan teselas gratuitas de OpenStreetMap/CARTO.
# Con token se usan los estilos de Mapbox (https://account.mapbox.com).
NEXT_PUBLIC_MAPBOX_TOKEN=
