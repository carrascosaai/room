{
  "sourceLanguage": "en",
  "strings": {
    "Add an expense to Taimo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an expense to Taimo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apuntar un gasto en Taimo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une dépense dans Taimo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe in Taimo hinzufügen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una spesa in Taimo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma despesa no Taimo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave toevoegen in Taimo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en utgift i Taimo"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en utgift i Taimo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en udgift i Taimo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kulu Taimoon"
          }
