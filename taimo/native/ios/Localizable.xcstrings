    "Logs a payment from your bank's notification text, without opening Taimo. Use it with the automation “When I get a notification from” your bank app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs a payment from your bank's notification text, without opening Taimo. Use it with the automation “When I get a notification from” your bank app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta un pago a partir del aviso de tu banco, sin abrir Taimo. Úsalo con la automatización «Cuando recibo una notificación de» la app de tu banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un paiement à partir de la notification de votre banque, sans ouvrir Taimo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst eine Zahlung aus der Benachrichtigung deiner Bank, ohne Taimo zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un pagamento dalla notifica della banca, senza aprire Taimo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista um pagamento a partir da notificação do banco, sem abrir o Taimo."
          }
        }
      }
    }
  },
  "version": "1.0"
}