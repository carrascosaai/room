# Grupos compartidos (Supabase). Sin estas dos variables la app funciona igual,
# pero los grupos se quedan solo en el móvil.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Web pública de Taimo, donde se abren los enlaces de «Pedir el dinero» (quien
# debe paga sin instalar nada). Por defecto, la publicada dentro de Room:
# scripts/publish-to-room.sh la deja en public/taimo.
EXPO_PUBLIC_WEB_URL=https://room-seven-steel.vercel.app/taimo
