# Grupos compartidos (Supabase). Sin estas dos variables la app funciona igual,
# pero los grupos se quedan solo en el móvil.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Web pública de Taimo (la exportación web de esta app). Con ella, «Pedir el dinero»
# manda un enlace que se abre en el navegador: quien debe paga sin instalar nada.
EXPO_PUBLIC_WEB_URL=https://tu-web-de-taimo.vercel.app
