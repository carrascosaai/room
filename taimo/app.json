{
  "expo": {
    "name": "Taimo",
    "slug": "taimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.taimo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.taimo"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.taimo"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2EE59D"
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0A0F0D",
          "resizeMode": "contain"
        }
      ],
      "./plugins/withTaimoAppIntent",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Taimo uses Face ID to keep your spending private."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Taimo uses the camera to read your receipts. Photos stay on your phone.",
          "photosPermission": "Taimo reads receipts from your photos. They stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TaimoWidget",
              "label": "Taimo",
              "description": "What you have left this month and per day",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/icon.png"
            }
          ]
        }
      ],
      "expo-quick-actions",
      "@bacons/apple-targets"
    ],
    "scheme": "taimo",
    "backgroundColor": "#0A0F0D",
    "experiments": {
      "typedRoutes": false
    }
  }
}
