# ─────────────────────────────────────────────────────────────
# ROOM — environment variables
# The game is fully playable with NONE of these set (in-memory
# store + deterministic AI). Set them to enable production mode.
# ─────────────────────────────────────────────────────────────

# --- Realtime / persistence (optional) ---
# When both are set, ROOM uses Supabase as the authoritative store.
# When unset, ROOM uses an in-process memory store (great for
# `next dev` on a local network; not suitable for serverless).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI language layer (optional) ---
# When unset, ROOM uses the deterministic commentary engine.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, local, ...).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- App ---
# Public base URL, used for QR codes / share links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Set to "0" to disable the analytics abstraction entirely.
NEXT_PUBLIC_ANALYTICS_ENABLED=1
